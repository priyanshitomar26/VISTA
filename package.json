{
  "name": "eds-visual-testing",
  "version": "1.0.0",
  "description": "EDS Page Visual Testing — dev.mobilityglobal.com vs www.mobilityglobal.com",
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "report": "playwright show-report",
    "capture:source": "node scripts/capture-screenshots.js source",
    "capture:target": "node scripts/capture-screenshots.js target",
    "capture:all": "node scripts/capture-screenshots.js all",
    "diff:report": "node scripts/generate-diff-report.js",
    "diff": "node scripts/run-visual-diff.js",
    "diff:desktop": "node scripts/run-visual-diff.js desktop",
    "diff:mobile": "node scripts/run-visual-diff.js mobile",
    "clean": "rimraf test-results playwright-report screenshots diff-report"
  },
  "dependencies": {
    "pixelmatch": "^5.3.0",
    "pngjs": "^7.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "@types/node": "^26.4.0",
    "@types/pngjs": "^6.0.5",
    "rimraf": "^5.0.0",
    "typescript": "^7.0.2"
  }
}
